[sub_resource type="GDScript" id="GDScript_0s3u6"]
resource_name = "Player_RPG_Move"
script/source = "extends CharacterBody2D

const SPEED := 120.0
var last_direction := \"down\"
var direction_vector := Vector2.ZERO

func _physics_process(_delta: float) -> void:
	# движение
	direction_vector = Input.get_vector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\")
	velocity = direction_vector * SPEED

	# направление взгляда (определяем по вводу)
	if direction_vector.y > 0:
		last_direction = \"down\"
	elif direction_vector.y < 0:
		last_direction = \"up\"

	elif direction_vector.x > 0:
		last_direction = \"right\"
	elif direction_vector.x < 0:
		last_direction = \"left\"

	# определяем тип анимации
	var anim_type := \"idle_\"
	if velocity.length() > 0:
		anim_type = \"walk_\"

	# проигрываем анимацию
	%Player_Tileset.play(anim_type + last_direction)

	# передвижение
	move_and_slide()
"

